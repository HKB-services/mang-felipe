{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Gate policy (CI + pre-push): fail only on blocking findings.
  // - dead code: unused files/exports/deps, cycles, boundary violations
  // - duplication: copy-paste clones
  // - health: functions above complexity/CRAP thresholds
  // Advisory output (hotspots, refactoring targets, large functions) is
  // informational only — use `bun run fallow:report` locally.
  //
  // fallow 2.86: no thresholdOverrides / maxLoc / maxParameters.
  // Without Istanbul coverage, CRAP ≈ CC^2 + CC, so maxCrap must track
  // maxCyclomatic or every mid-size form fails the gate.
  "ignoreDependencies": ["@react-email/ui"],
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 22,
    // Inclusive CRAP gate; zero-coverage CRAP for CC=20 is 420.
    "maxCrap": 421,
    "ignore": [
      "**/*.generated.ts",
      "**/app/*hidden*/**",
      "**/prisma/seed.ts",
      // shadcn chart primitive — dense Recharts wiring, not app logic
      "components/ui/chart.tsx",
    ],
  },
  "duplicates": {
    // Percentage ceiling (0 = no limit). Clone groups in ignored paths
    // are excluded from the gate.
    "threshold": 5,
    "minLines": 30,
    "ignore": [
      "emails/**",
      "**/app/*hidden*/**",
      // Landing sections share motion/layout boilerplate by design
      "features/landing/components/**",
    ],
  },
  "audit": {
    "cacheMaxAgeDays": 0,
    "gate": "new-only",
  },
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "coverage-gaps": "off",
  },
}
