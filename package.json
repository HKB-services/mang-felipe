{
  "name": "next-js-neon-starter",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 5001",
    "build": "next build",
    "email:dev": "email dev",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "doctor": "react-doctor",
    "fallow": "fallow --fail-on-issues --summary",
    "fallow:report": "fallow",
    "graphify": "graphify update",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:deploy:dev": "PRISMA_ENV_FILE=.env.development prisma migrate deploy",
    "db:migrate:deploy:prod": "PRISMA_ENV_FILE=.env.production prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "PRISMA_ENV_FILE=.env.development bun run prisma/seed.ts",
    "db:seed:real": "PRISMA_ENV_FILE=.env.development SEED_REAL_PRICES=true bun run prisma/seed.ts",
    "db:seed:prod": "PRISMA_ENV_FILE=.env.production bun run prisma/seed.ts",
    "db:seed:prod:real": "PRISMA_ENV_FILE=.env.production SEED_REAL_PRICES=true bun run prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@base-ui/react": "1.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tabler/icons-react": "3.44.0",
    "@tanstack/react-form": "1.32.0",
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-table": "8.21.3",
    "@types/crypto-js": "4.2.2",
    "axios": "^1.19.0",
    "better-auth": "^1.6.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "crypto-js": "4.2.0",
    "dotenv": "^17.4.2",
    "jotai": "2.20.0",
    "nanoid": "^6.0.0",
    "next": "16.2.6",
    "next-safe-action": "8.5.3",
    "next-themes": "0.4.6",
    "nextjs-toploader": "3.9.17",
    "nuqs": "2.8.9",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-email": "6.9.2",
    "shadcn": "4.8.0",
    "sileo": "0.1.5",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "25.5.0",
    "@types/pg": "^8.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.1.7",
    "fallow": "2.86.0",
    "husky": "9.1.7",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.25",
    "postcss-load-config": "6.0.1",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "prisma": "^7.9.1",
    "react-doctor": "0.2.16",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}