// Guest orders — customer details, fulfillment slot, manual payment proof.

enum OrderStatus {
  pending_review
  confirmed
  rejected
  cancelled
}

enum PaymentChannel {
  unionbank
  gcash
  bpi
}

enum FulfillmentType {
  pickup
  delivery
}

/// Local time windows (store timezone: Asia/Manila).
enum FulfillmentSlot {
  slot_10_12
  slot_14_16
  slot_17_19
}

model Order {
  id          String      @id @default(cuid())
  /// Human-readable code, e.g. HM-20260807-A1B2
  orderNumber String      @unique
  status      OrderStatus @default(pending_review)

  customerName  String
  /// Optional — order email receipt only when present.
  customerEmail String?
  customerPhone String

  fulfillmentType FulfillmentType
  /// Pickup / delivery date. App enforces ≥ next calendar day.
  fulfillmentDate DateTime
  fulfillmentSlot FulfillmentSlot

  /// Required when fulfillmentType = delivery; optional for pickup.
  deliveryAddress String?
  deliveryNotes   String?

  /// Admin-pasted Lalamove share / tracking URL (delivery). Not GPS of our own.
  lalamoveTrackingUrl     String?
  lalamoveTrackingSavedAt DateTime?
  /// When tracking-link email was last sent to customerEmail (if any).
  lalamoveTrackingEmailedAt DateTime?

  paymentChannel         PaymentChannel
  /// R2 object key for payment screenshot.
  paymentProofKey        String?
  paymentProofUploadedAt DateTime?

  /// Sum of line totals in whole PHP. Delivery fee not included.
  subtotalPhp Int

  adminNotes       String?
  reviewedAt       DateTime?
  reviewedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([status])
  @@index([customerEmail])
  @@index([fulfillmentDate])
  @@index([fulfillmentType])
  @@index([createdAt])
  @@map("order")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String?
  menuItem   MenuItem?        @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  variantId  String?
  variant    MenuItemVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  /// Snapshots so later menu price edits do not rewrite history.
  itemName     String
  variantLabel String
  portionLabel String
  unitPricePhp Int
  quantity     Int
  lineTotalPhp Int
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([menuItemId])
  @@index([variantId])
  @@map("order_item")
}
